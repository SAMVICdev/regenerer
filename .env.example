# ============================================================
#  🔐 Variables d'environnement — Ministère Les Régénérés
# ------------------------------------------------------------
#  1. Copiez ce fichier en « .env » :   cp .env.example .env
#  2. Remplissez vos valeurs.
#  3. Lancez :                          npm run config
#     (le script scripts/build-config.js injecte les valeurs
#      dans js/config.js, sans écraser vos liens/événements)
#
#  ⚠ Ne commitez JAMAIS le fichier .env (il contient vos clés).
# ============================================================

# --- YouTube (obligatoire pour la détection automatique du direct) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_HANDLE=ministeleresregeneres
# Facultatif : forcer un ID de vidéo (tests / événement ponctuel)
YOUTUBE_LIVE_VIDEO_ID=

# --- Réseaux sociaux (facultatif — remplace les liens de config.js) ---
FACEBOOK_URL=https://www.facebook.com/ministeleresregeneres
INSTAGRAM_URL=https://www.instagram.com/ministeleresregeneres
TIKTOK_URL=https://www.tiktok.com/@ministeleresregeneres
YOUTUBE_URL=https://www.youtube.com/@ministeleresregeneres

# --- WhatsApp officiel (format international, SANS le +) ---
WHATSAPP_URL=https://wa.me/22893357515
