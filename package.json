{
  "name": "ministere-les-regeneres",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page officielle du Ministère Les Régénérés - Lomé, Togo",
  "scripts": {
    "config": "node scripts/build-config.js",
    "build": "node scripts/build-config.js && tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "build:css": "tailwindcss -i ./src/input.css -o ./css/styles.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./css/styles.css --watch",
    "serve": "python3 -m http.server 8080"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
